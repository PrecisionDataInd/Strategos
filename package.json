{
  "name": "strategos",
  "version": "1.0.0",
  "description": "Autonomous Solana DeFi Agent — STRATEGOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "install-all": "npm install --legacy-peer-deps"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.4",
    "@solana/spl-token": "^0.4.6",
    "@anthropic-ai/sdk": "^0.30.0",
    "@marinade.finance/marinade-ts-sdk": "^5.0.18",
    "@orca-so/whirlpools-sdk": "^0.13.0",
    "@orca-so/common-sdk": "^0.6.0",
    "@coral-xyz/anchor": "^0.30.0",
    "@solendprotocol/solend-sdk": "^0.14.26",
    "@raydium-io/raydium-sdk-v2": "^2.0.0-rc.20",
    "jito-ts": "^3.0.0",
    "decimal.js": "^10.4.3",
    "cross-fetch": "^4.0.0",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "nodemailer": "^6.9.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.strategos.agent",
    "productName": "Strategos",
    "copyright": "Strategos Autonomous Field Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**",
      "!**/*.map",
      "!.env",
      "!.env.example"
    ],
    "extraFiles": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/strategos.ico",
      "publisherName": "Strategos",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/strategos.ico",
      "uninstallerIcon": "assets/strategos.ico",
      "installerHeaderIcon": "assets/strategos.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Strategos",
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Strategos-Portable-${version}.exe"
    }
  }
}
