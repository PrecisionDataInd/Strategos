# Strategos Agent Configuration
# Copy this file to .env and fill in your actual values

# Your agent wallet's private key in Base58 format
AGENT_WALLET_PRIVATE_KEY=your_private_key_here

# Your vault wallet's PUBLIC address
VAULT_WALLET_PUBLIC_KEY=your_vault_public_address_here

# Solana RPC endpoint
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Anthropic API key for NOVA intelligence briefs
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Gmail credentials for daily report emails
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here